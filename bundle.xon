; bundle.xon -- what this bundle is.

(name "backgammon")

; Helium, plus exactly the libraries this bundle imports and nothing
; ambient.
(dialect he)

(requires-release "v0.62.0")

; The window board draws with the graphics library.
(requires-bundle "gfx" "v0.1.0" "jonruttan/x-lib-gfx")

(entry run)
